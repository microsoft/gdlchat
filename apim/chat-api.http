@gatewayUrl = https://nvmtr2apim.azure-api.net/chat-api
@backendUrl = http://localhost:5093/chat/api/chat
@subscriptionKey = {{$processEnv ChatGateway__SubscriptionKey}}

### Expected 401 at APIM without an application subscription.
POST {{gatewayUrl}}/messages
Content-Type: application/json

{"message":"Hello"}

### Expected 403 from the supplied inbound policy, without an agent call.
POST {{gatewayUrl}}/messages
Content-Type: application/json
Ocp-Apim-Subscription-Key: {{subscriptionKey}}

{"message":"policy-block-test"}

### Expected 400 from request schema validation.
POST {{gatewayUrl}}/messages
Content-Type: application/json
Ocp-Apim-Subscription-Key: {{subscriptionKey}}

{"unexpected":"No message"}

### Expected 200, with conversationId and messages. Sends a real agent message.
# @name startConversation
POST {{gatewayUrl}}/messages
Content-Type: application/json
Ocp-Apim-Subscription-Key: {{subscriptionKey}}

{"conversationId":null,"message":"Hello. Please briefly introduce yourself."}

### Expected 200, continuing the same conversation. Run startConversation first.
POST {{gatewayUrl}}/messages
Content-Type: application/json
Ocp-Apim-Subscription-Key: {{subscriptionKey}}

{"conversationId":"{{startConversation.response.body.$.conversationId}}","message":"What was my first message?"}

### Expected 410 for an unknown or expired conversation.
POST {{gatewayUrl}}/messages
Content-Type: application/json
Ocp-Apim-Subscription-Key: {{subscriptionKey}}

{"conversationId":"11111111-1111-4111-8111-111111111111","message":"Hello"}

### Expected 401 directly at the backend after BackendKey is configured; otherwise 503.
POST {{backendUrl}}/messages
Content-Type: application/json

{"message":"This must not reach the agent without the gateway credential."}